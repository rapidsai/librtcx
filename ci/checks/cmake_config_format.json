{
  "format": {
    "line_width": 100,
    "tab_size": 2,
    "command_case": "unchanged",
    "dangle_parens": false,
    "max_subgroups_hwrap": 4,
    "min_prefix_chars": 32,
    "max_pargs_hwrap": 999
  },
  "parse": {
    "additional_commands": {
      "rtcx_add_embed": {
        "pargs": 1
      },
      "rtcx_embed_includes": {
        "pargs": 1,
        "kwargs": {
          "SOURCE_DIRECTORY": 1,
          "DEST_DIRECTORY": 1,
          "INCLUDE_DIRECTORIES": "+",
          "FILES": "*"
        }
      },
      "rtcx_embed_blob": {
        "pargs": 1,
        "kwargs": {
          "ID": 1,
          "FILE": 1,
          "DEST": 1,
          "ARRAY_IDS": "*",
          "ARRAY_VALUES": "*"
        }
      },
      "rtcx_embed": {
        "pargs": 1,
        "kwargs": {
          "COMPRESSION": 1,
          "OUTPUT_DIRECTORY": 1
        }
      },
      "rtcx_jit_lto_embed_begin": {
        "pargs": 1,
        "kwargs": {
          "OUTPUT_DIRECTORY": 1
        }
      },
      "rtcx_jit_lto_embed_finalize": {
        "pargs": 1,
        "kwargs": {
          "SOURCE_LIST": 1
        }
      }
    }
  }
}
