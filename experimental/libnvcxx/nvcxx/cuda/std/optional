#pragma once

#include <nvcxx/cuda/detail/config>

namespace nvcxx::std {

struct nullopt_t {
  explicit constexpr nullopt_t(int) {}
};

inline constexpr nullopt_t nullopt{0};

template <class T>
class optional {
  union {
    unsigned char empty_;
    T value_;
  };
  bool engaged_;

 public:
  using value_type = T;

  constexpr optional() : empty_{}, engaged_{false} {}

  constexpr optional(nullopt_t) : optional() {}

  constexpr optional(T const& t) : value_{t}, engaged_{true} {}

  constexpr optional(T&& t) : value_{::std::move(t)}, engaged_{true} {}

  constexpr optional& operator=(nullopt_t)
  {
    engaged_ = false;
    return *this;
  }

  constexpr optional& operator=(T const& v)
  {
    value_   = v;
    engaged_ = true;
    return *this;
  }

  template <class... Args>
  constexpr T& emplace(Args&&... args)
  {
    if (engaged_) {
      value_.~T();
      engaged_ = false;
    }
    T* result =
      ::new (static_cast<void*>(__builtin_addressof(value_))) T(::std::forward<Args>(args)...);
    engaged_ = true;
    return *result;
  }

  constexpr T* begin() { return engaged_ ? __builtin_addressof(value_) : nullptr; }

  constexpr T const* begin() const { return engaged_ ? __builtin_addressof(value_) : nullptr; }

  constexpr T* end() { return engaged_ ? __builtin_addressof(value_) + 1 : nullptr; }

  constexpr T const* end() const { return engaged_ ? __builtin_addressof(value_) + 1 : nullptr; }

  constexpr T const* cbegin() const { return begin(); }

  constexpr T const* cend() const { return end(); }

  constexpr ::size_t size() const { return engaged_ ? 1 : 0; }

  constexpr bool empty() const { return !engaged_; }

  constexpr explicit operator bool() const { return engaged_; }

  constexpr bool has_value() const { return engaged_; }

  constexpr T& operator*() { return value_; }

  constexpr T const& operator*() const { return value_; }

  constexpr T* operator->() { return &value_; }

  constexpr T const* operator->() const { return &value_; }

  constexpr T value_or(T const& fallback) const { return engaged_ ? value_ : fallback; }

  constexpr T& value() { return value_; }

  constexpr T const& value() const { return value_; }
};

template <class T, class U>
  requires requires(T const& a, U const& b) {
    requires __is_convertible_to(decltype(a == b), bool);
  }
constexpr bool operator==(optional<T> const& a, optional<U> const& b)
{
  if (a.has_value() != b.has_value()) { return false; }
  return !a.has_value() || *a == *b;
}

template <class T, class U>
  requires requires(T const& a, U const& b) {
    requires __is_convertible_to(decltype(a != b), bool);
  }
constexpr bool operator!=(optional<T> const& a, optional<U> const& b)
{
  if (a.has_value() != b.has_value()) { return true; }
  return a.has_value() && *a != *b;
}

}  // namespace nvcxx::std
