#pragma once

#include <nvcxx/cuda/detail/config>

namespace nvcxx::std {

// Type constants

template <class T, T V>
struct integral_constant {
  using value_type = T;
  using type       = integral_constant;

  static constexpr T value = V;

  constexpr operator T() const { return V; }

  constexpr T operator()() const { return V; }
};

template <bool V>
using bool_constant = integral_constant<bool, V>;

using true_type = bool_constant<true>;

using false_type = bool_constant<false>;

// Template utilities

template <bool B, class T, class F>
struct conditional {
  using type = T;
};

template <class T, class F>
struct conditional<false, T, F> {
  using type = F;
};

template <bool B, class T, class F>
using conditional_t = typename conditional<B, T, F>::type;

template <bool B, class T = void>
struct enable_if {};

template <class T>
struct enable_if<true, T> {
  using type = T;
};

template <bool B, class T = void>
using enable_if_t = typename enable_if<B, T>::type;

template <class...>
using void_t = void;

template <class...>
struct disjunction : false_type {};

template <class B, class... Rest>
struct disjunction<B, Rest...> : conditional_t<bool(B::value), B, disjunction<Rest...>> {};

template <class... B>
inline constexpr bool disjunction_v = disjunction<B...>::value;

namespace detail {

template <class T, class = void>
struct reference_types {
  using lvalue = T;
  using rvalue = T;
};

template <class T>
struct reference_types<T, void_t<T&>> {
  using lvalue = T&;
  using rvalue = T&&;
};

}  // namespace detail

template <class T>
typename detail::reference_types<T>::rvalue declval();

// Type transformations

template <class T>
struct remove_cv {
  using type = __remove_cv(T);
};

template <class T>
using remove_cv_t = __remove_cv(T);

template <class T>
struct remove_reference {
  using type = __remove_reference(T);
};

template <class T>
using remove_reference_t = __remove_reference(T);

template <class T>
using remove_cvref_t = __remove_cvref(T);

template <class T>
using decay_t = __decay(T);

template <class T>
struct make_signed {
  using type = __make_signed(T);
};

template <class T>
using make_signed_t = __make_signed(T);

template <class T>
struct make_unsigned {
  using type = __make_unsigned(T);
};

template <class T>
using make_unsigned_t = __make_unsigned(T);

// Type relationships

template <class T, class U>
inline constexpr bool is_same_v = false;

template <class T>
inline constexpr bool is_same_v<T, T> = true;

template <class T, class U>
using is_same = bool_constant<is_same_v<T, U>>;

template <class From, class To>
struct is_convertible : bool_constant<__is_convertible_to(From, To)> {};

template <class From, class To>
inline constexpr bool is_convertible_v = is_convertible<From, To>::value;

template <class Base, class Derived>
struct is_base_of : bool_constant<__is_base_of(Base, Derived)> {};

template <class Base, class Derived>
inline constexpr bool is_base_of_v = is_base_of<Base, Derived>::value;

// Implementation helpers

namespace detail {

template <class T>
inline constexpr bool is_pointer_impl = false;

template <class T>
inline constexpr bool is_pointer_impl<T*> = true;

template <class T>
inline constexpr bool is_member_pointer_impl = false;

template <class T, class C>
inline constexpr bool is_member_pointer_impl<T C::*> = true;

}  // namespace detail

// Type classifications

template <class T>
inline constexpr bool is_lvalue_reference_v = false;

template <class T>
inline constexpr bool is_lvalue_reference_v<T&> = true;

template <class T>
using is_lvalue_reference = bool_constant<is_lvalue_reference_v<T>>;

template <class T>
inline constexpr bool is_function_v = __is_function(T);

template <class T>
using is_function = bool_constant<is_function_v<T>>;

template <class T>
inline constexpr bool is_object_v =
  !is_function_v<T> && is_same_v<T, remove_reference_t<T>> && !is_same_v<remove_cv_t<T>, void>;

template <class T>
using is_object = bool_constant<is_object_v<T>>;

template <class T>
inline constexpr bool is_void_v = is_same_v<remove_cv_t<T>, void>;

template <class T>
using is_void = bool_constant<is_void_v<T>>;

template <class T>
inline constexpr bool is_integral_v =
  is_same_v<remove_cv_t<T>, bool> || is_same_v<remove_cv_t<T>, char> ||
  is_same_v<remove_cv_t<T>, signed char> || is_same_v<remove_cv_t<T>, unsigned char> ||
  is_same_v<remove_cv_t<T>, wchar_t> || is_same_v<remove_cv_t<T>, char8_t> ||
  is_same_v<remove_cv_t<T>, char16_t> || is_same_v<remove_cv_t<T>, char32_t> ||
  is_same_v<remove_cv_t<T>, short> || is_same_v<remove_cv_t<T>, unsigned short> ||
  is_same_v<remove_cv_t<T>, int> || is_same_v<remove_cv_t<T>, unsigned int> ||
  is_same_v<remove_cv_t<T>, long> || is_same_v<remove_cv_t<T>, unsigned long> ||
  is_same_v<remove_cv_t<T>, long long> || is_same_v<remove_cv_t<T>, unsigned long long> ||
  is_same_v<remove_cv_t<T>, __int128> || is_same_v<remove_cv_t<T>, unsigned __int128>;

template <class T>
using is_integral = bool_constant<is_integral_v<T>>;

template <class T>
inline constexpr bool is_floating_point_v =
  is_same_v<remove_cv_t<T>, float> || is_same_v<remove_cv_t<T>, double> ||
  is_same_v<remove_cv_t<T>, long double>;

template <class T>
using is_floating_point = bool_constant<is_floating_point_v<T>>;

template <class T>
inline constexpr bool is_enum_v = __is_enum(T);

template <class T>
using is_enum = bool_constant<is_enum_v<T>>;

template <class T>
inline constexpr bool is_pointer_v = detail::is_pointer_impl<remove_cv_t<T>>;

template <class T>
struct is_pointer : bool_constant<is_pointer_v<T>> {};

template <class T>
inline constexpr bool is_arithmetic_v = is_integral_v<T> || is_floating_point_v<T>;

template <class T>
using is_arithmetic = bool_constant<is_arithmetic_v<T>>;

template <class T>
inline constexpr bool is_fundamental_v =
  is_arithmetic_v<T> || is_void_v<T> || is_same_v<remove_cv_t<T>, decltype(nullptr)>;

template <class T>
using is_fundamental = bool_constant<is_fundamental_v<T>>;

template <class T>
inline constexpr bool is_scalar_v =
  is_arithmetic_v<T> || is_enum_v<T> || is_pointer_v<T> ||
  detail::is_member_pointer_impl<remove_cv_t<T>> || is_same_v<remove_cv_t<T>, decltype(nullptr)>;

template <class T>
using is_scalar = bool_constant<is_scalar_v<T>>;

template <class T>
inline constexpr bool is_compound_v = !is_fundamental_v<T>;

template <class T>
using is_compound = bool_constant<is_compound_v<T>>;

// Type properties

template <class T>
inline constexpr bool is_const_v = false;

template <class T>
inline constexpr bool is_const_v<T const> = true;

template <class T>
using is_const = bool_constant<is_const_v<T>>;

template <class T>
inline constexpr bool is_volatile_v = false;

template <class T>
inline constexpr bool is_volatile_v<T volatile> = true;

template <class T>
using is_volatile = bool_constant<is_volatile_v<T>>;

template <class T>
inline constexpr bool is_signed_v = [] {
  if constexpr (is_arithmetic_v<T>) {
    return remove_cv_t<T>(-1) < remove_cv_t<T>(0);
  } else {
    return false;
  }
}();

template <class T>
using is_signed = bool_constant<is_signed_v<T>>;

template <class T>
inline constexpr bool is_unsigned_v = is_arithmetic_v<T> && !is_signed_v<T>;

template <class T>
using is_unsigned = bool_constant<is_unsigned_v<T>>;

template <class T>
inline constexpr bool is_trivial_v = __is_trivial(T);

template <class T>
using is_trivial = bool_constant<is_trivial_v<T>>;

template <class T>
inline constexpr bool is_trivially_copyable_v = __is_trivially_copyable(T);

template <class T>
using is_trivially_copyable = bool_constant<is_trivially_copyable_v<T>>;

// Destruction

template <class T>
inline constexpr bool is_destructible_v = __is_destructible(T);

template <class T>
using is_destructible = bool_constant<is_destructible_v<T>>;

// Construction and assignment

template <class T, class... Args>
inline constexpr bool is_constructible_v = __is_constructible(T, Args...);

template <class T, class... Args>
using is_constructible = bool_constant<is_constructible_v<T, Args...>>;

template <class T>
inline constexpr bool is_default_constructible_v = is_constructible_v<T>;

template <class T>
using is_default_constructible = bool_constant<is_default_constructible_v<T>>;

template <class T>
inline constexpr bool is_copy_constructible_v =
  is_constructible_v<T, typename detail::reference_types<T const>::lvalue>;

template <class T>
using is_copy_constructible = bool_constant<is_copy_constructible_v<T>>;

template <class T>
inline constexpr bool is_move_constructible_v =
  is_constructible_v<T, typename detail::reference_types<T>::rvalue>;

template <class T>
using is_move_constructible = bool_constant<is_move_constructible_v<T>>;

template <class T, class U>
inline constexpr bool is_assignable_v = __is_assignable(T, U);

template <class T, class U>
using is_assignable = bool_constant<is_assignable_v<T, U>>;

template <class T>
inline constexpr bool is_copy_assignable_v =
  is_assignable_v<typename detail::reference_types<T>::lvalue,
                  typename detail::reference_types<T const>::lvalue>;

template <class T>
using is_copy_assignable = bool_constant<is_copy_assignable_v<T>>;

template <class T>
inline constexpr bool is_move_assignable_v =
  is_assignable_v<typename detail::reference_types<T>::lvalue,
                  typename detail::reference_types<T>::rvalue>;

template <class T>
using is_move_assignable = bool_constant<is_move_assignable_v<T>>;

// Common types

template <class... T>
struct common_type;

template <class... T>
using common_type_t = typename common_type<T...>::type;

namespace detail {

template <class T>
struct type_identity {
  using type = T;
};

template <int N>
struct common_priority : common_priority<N - 1> {};

template <>
struct common_priority<0> {};

struct no_common_type {};

template <class T, class U>
auto common_type_select(common_priority<1>)
  -> type_identity<decay_t<decltype(false ? declval<T>() : declval<U>())>>;

template <class T, class U>
auto common_type_select(common_priority<0>)
  -> type_identity<decay_t<decltype(false ? declval<T const&>() : declval<U const&>())>>;

template <class T, class U>
auto common_type_select(...) -> no_common_type;

template <class T, class U, bool = is_same_v<T, decay_t<T>> && is_same_v<U, decay_t<U>>>
struct common_type_pair : common_type<decay_t<T>, decay_t<U>> {};

template <class T, class U>
struct common_type_pair<T, U, true> : decltype(common_type_select<T, U>(common_priority<1>{})) {};

template <class T, class U, class = void>
struct common_type_pack {};

template <class... T, class... U>
struct common_type_pack<common_type<T...>, common_type<U...>, void_t<common_type_t<T...>>>
  : common_type<common_type_t<T...>, U...> {};

}  // namespace detail

template <class... T>
struct common_type {};

template <class T>
struct common_type<T> : common_type<T, T> {};

template <class T, class U>
struct common_type<T, U> : detail::common_type_pair<T, U> {};

template <class T, class U, class... R>
struct common_type<T, U, R...> : detail::common_type_pack<common_type<T, U>, common_type<R...>> {};

// Constant evaluation

constexpr bool is_constant_evaluated() noexcept { return __builtin_is_constant_evaluated(); }

}  // namespace nvcxx::std
