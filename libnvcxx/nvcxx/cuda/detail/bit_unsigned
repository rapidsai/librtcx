#pragma once

#include <nvcxx/cuda/std/type_traits>

namespace nvcxx::std::detail {

template <class T>
concept bit_unsigned = is_same_v<T, unsigned char> || is_same_v<T, unsigned short> ||
                       is_same_v<T, unsigned int> || is_same_v<T, unsigned long> ||
                       is_same_v<T, unsigned long long> || is_same_v<T, unsigned __int128>;

}  // namespace nvcxx::std::detail
