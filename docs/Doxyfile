DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = librtcx
PROJECT_NUMBER          = $(RTCX_VERSION)
PROJECT_BRIEF           = "Runtime compilation and linking utilities for CUDA"
OUTPUT_DIRECTORY        = $(RTCX_DOCS_OUTPUT)

FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = ..
STRIP_FROM_INC_PATH     = ..

MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
BUILTIN_STL_SUPPORT     = YES
CPP_CLI_SUPPORT         = NO

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO

INPUT                   = ../include/rtcx ../README.md
FILE_PATTERNS           = *.hpp *.md
RECURSIVE               = NO
USE_MDFILE_AS_MAINPAGE  = ../README.md

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

QUIET                   = YES
WARNINGS                = YES
# Existing public headers are not yet fully documented. Keep malformed documentation fatal without
# requiring every public symbol to have documentation.
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO

GENERATE_LATEX          = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_XML            = NO
GENERATE_DOCBOOK        = NO

HAVE_DOT                = NO
CLASS_DIAGRAMS          = NO

MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
PREDEFINED              = __attribute__(x)= \
                          __declspec(x)=
